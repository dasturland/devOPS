# TableReserve namunaviy muhit o'zgaruvchilari.
# Haqiqiy qiymatlar bilan `.env` fayliga nusxalang. Sir qiymatlarni commit qilmang.

# Django asosiy sozlamalari
SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Ma'lumotlar bazasi (prod uchun PostgreSQL)
# DATABASE_URL ko'rinishida yoki alohida POSTGRES_* orqali bering.
DATABASE_URL=
POSTGRES_DB=tablereserve
POSTGRES_USER=tablereserve
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email (prod uchun SMTP; dev'da console backend ishlatiladi)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TableReserve <no-reply@example.com>

# Logging
DJANGO_LOG_LEVEL=DEBUG
